pkgname=whereis
pkgver=0
pkgrel=${pkgrel:-0}
pkgdesc="$pkgname for QNX"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
source="$pkgname.c"

build() {
    gcc $pkgname.c -O2 -o $pkgname
}

package() {
    mkdir -p "$pkgdir"/usr/bin
    install -v -m755 $srcdir/$pkgname "$pkgdir"/usr/bin
}

options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
20ad247514bb3fe450ea151d186bdb3600e415cb478f9dbded5eb888d4b51c51309756629e892ea57147b176d3ebd1d2c11ce7004df07146f6ef8fa23cecdb5f  whereis.c
"
